{
    "compilerOptions": {
      "target": "esnext",
      "module": "esnext",
      "moduleResolution": "node",
      "strict": true,
      "jsx": "preserve",
      "esModuleInterop": true,
      "allowJs": true,
      "skipLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["./src/*"] // Mapeia o alias @ para src
      },
      "types": ["node", "@nuxt/types"]
    },
    "include": [
      "src/**/*.ts",
      "src/**/*.vue",
      "nuxt.config.ts" // Inclui o arquivo de configuração do Nuxt
    ],
    "exclude": ["node_modules", ".nuxt", "dist"]
  }
  